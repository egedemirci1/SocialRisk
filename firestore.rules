rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Yardımcı fonksiyonlar ────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.uid in [
        'y51M7E6YXZT5I04M9YFqGzSgZ7Y2',
        'hW42qgzVJIXr6sOLO0q1zPOdv6w1',
        'd7sLOX946mRfrmkYMRUOJXNa44l2' // Reze
      ];
    }

    function roomExists(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId));
    }

    function isRoomPlayer(roomId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid));
    }

    function isRoomHost(roomId) {
      return isAuthenticated()
        && roomExists(roomId)
        && get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid;
    }

    function gameRoomId(gameId) {
      return get(/databases/$(database)/documents/games/$(gameId)).data.roomId;
    }

    function isVotingPhase(gameId) {
      return get(/databases/$(database)/documents/games/$(gameId)).data.status == 'voting';
    }

    function isCurrentPlayer(gameId) {
      return get(/databases/$(database)/documents/games/$(gameId)).data.currentPlayerId == request.auth.uid;
    }

    function isCurrentGamePlayer(gameId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/games/$(gameId)).data.roomId is string
        && exists(/databases/$(database)/documents/rooms/$(get(/databases/$(database)/documents/games/$(gameId)).data.roomId)/players/$(request.auth.uid));
    }

    // ─── Rooms ────────────────────────────────────────────
    match /rooms/{roomId} {
      // Herkes oda bilgilerini okuyabilir (lobi katılım için gerekli)
      allow read: if isAuthenticated();

      // Oda oluşturma: giriş yapmış kullanıcı
      allow create: if isAuthenticated();

      // Güncelleme: sadece odadaki oyuncular VEYA playerCount güncellemesi
      allow update: if isAuthenticated()
        && (
          // Odadaki oyuncu herhangi bir alanı güncelleyebilir
          exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid))
          || existsAfter(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid))
          // VEYA sadece playerCount güncellemesi (join/leave işlemleri için)
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerCount'])
        );

      // Silme: sadece host
      allow delete: if isAuthenticated()
        && resource.data.hostId == request.auth.uid;

      // ─── Players alt koleksiyonu ──────────────────────
      match /players/{playerId} {
        // Okuma: odadaki herkes
        allow read: if isAuthenticated();

        // Oluşturma: sadece kendi belgesini oluşturabilir
        allow create: if isAuthenticated()
          && isOwner(playerId);

        // Güncelleme: kendi verisi VEYA host (skor güncellemesi için)
        allow update: if isAuthenticated()
          && (isOwner(playerId)
            || get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName',
            'avatarUrl',
            'activeFrame',
            'activeTitle',
            'score',
            'isReady',
            'lastSeenAt',
            'passStreak'
          ]);

        // Silme (odadan çıkma): kendi belgesi veya host
        allow delete: if isAuthenticated()
          && (isOwner(playerId)
            || get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid);
      }
    }

    // ─── Games ────────────────────────────────────────────
    match /games/{gameId} {
      // Okuma: sadece ilişkili odadaki oyuncular
      allow read: if isAuthenticated()
        && resource.data.roomId is string
        && isRoomPlayer(resource.data.roomId);

      // Oluşturma: yalnızca oda hostu kendi odası için oyun açabilir
      allow create: if isAuthenticated()
        && request.resource.data.roomId is string
        && isRoomHost(request.resource.data.roomId);

      // Güncelleme: yalnızca oda içindeki oyuncular; host olmayanlar status/sonuç alanlarını yazamasın
      allow update: if isAuthenticated()
        && resource.data.roomId is string
        && isCurrentGamePlayer(gameId)
        && request.resource.data.roomId == resource.data.roomId
        && (
          isRoomHost(resource.data.roomId)
          || isCurrentPlayer(gameId)
        )
        // Alan bazlı validasyon
        && (
          // Host her zaman her şeyi güncelleyebilir
          isRoomHost(resource.data.roomId)
          // Current player sadece belirli alanları güncelleyebilir
          || isCurrentPlayer(gameId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'spinningTarget',
            'selectedCategory',
            'selectedDifficulty',
            'currentTask',
            'usedTaskIds',
            'status',
            'categoryPickCounts',
            'lockedCategories',
            'categoryMarketValues',
            'passStreak',
            'currentPlayerId',
            'currentRound',
            'lastRoundScore',
            'lastRoundMultiplier',
            'lastRoundPlayerId'
          ])
        )

      // Silme: yok (oyunlar silinmez, Cloud Function temizler)
      allow delete: if false;

      // ─── Votes alt koleksiyonu ──────────────────────
      match /votes/{voterId} {
        // Okuma: sadece oda oyuncuları
        allow read: if isAuthenticated()
          && get(/databases/$(database)/documents/games/$(gameId)).data.roomId is string
          && isRoomPlayer(get(/databases/$(database)/documents/games/$(gameId)).data.roomId);

        // Yazma: sadece kendi oyunu yazabilir
        allow create: if isAuthenticated()
          && isOwner(voterId)
          && gameRoomId(gameId) is string
          && isRoomPlayer(gameRoomId(gameId))
          && isVotingPhase(gameId)
          && !isCurrentPlayer(gameId)
          && request.resource.data.keys().hasOnly(['value', 'timedOut', 'penaltyApplied'])
          && request.resource.data.value in ['like', 'neutral', 'dislike']
          && request.resource.data.penaltyApplied == false;
        allow update: if isAuthenticated()
          && isOwner(voterId)
          && gameRoomId(gameId) is string
          && isRoomPlayer(gameRoomId(gameId))
          && isVotingPhase(gameId)
          && !isCurrentPlayer(gameId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['value', 'timedOut', 'penaltyApplied'])
          && request.resource.data.value in ['like', 'neutral', 'dislike'];

        // Silme: sadece host veya oy sahibi
        allow delete: if isAuthenticated()
          && get(/databases/$(database)/documents/games/$(gameId)).data.roomId is string
          && (
            isOwner(voterId)
            || isRoomHost(get(/databases/$(database)/documents/games/$(gameId)).data.roomId)
          );
      }
    }

    // ─── Users (Profil + Cüzdan + Envanter) ──────────────
    match /users/{userId} {
      // Okuma: herkes (avatar vb. görmek için)
      allow read: if isAuthenticated();

      // Oluşturma: kendi belgesini
      allow create: if isAuthenticated()
        && isOwner(userId);

      // Güncelleme: kendi belgesini
      allow update: if isAuthenticated()
        && isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'avatarUrl',
          'activeFrame',
          'activeTitle',
          'updatedAt',
          'wallet',
          'walletPoints',
          'ownedCosmetics'
        ]);

      // Silme yok
      allow delete: if false;

      // ─── Custom Tasks alt koleksiyonu ─────────────────
      match /custom_tasks/{taskId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }

    // 🛍️ Cosmetics (Mağaza Öğeleri) 🛍️
    match /cosmetics/{cosmeticId} {
      // Her authenticated kullanıcı okuyabilir (mağaza listesi için)
      allow read: if isAuthenticated();
      
      // Oluşturma/güncelleme/silme: sadece admin
      allow create, update, delete: if isAdmin()
        && request.resource.data.keys().hasAll(['id', 'name', 'price', 'type', 'imageUrl'])
        && request.resource.data.price is int
        && request.resource.data.price >= 0
        && request.resource.data.type in ['title', 'frame', 'category'];
    }

    // ─── Tasks (Görevler ve Admin) ────────────────────────
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      // Yalnızca adminler görev ekleyebilir, silebilir veya güncelleyebilir.
      allow write: if isAdmin();
    }
    
    match /taskFeedback/{feedbackId} {
      allow read: if isAuthenticated();
      // Herkes feedback verebilir.
      allow create: if isAuthenticated();
      // Feedback güncellenemez/silinemez
      allow update, delete: if false;
    }
    
    // ─── Raporlar (Moderasyon) ────────────────────────────
    match /reports/{reportId} {
      // Herkes rapor oluşturabilir (şikayet mekanizması)
      allow create: if isAuthenticated();
      // Yalnızca adminler raporları okuyabilir ve yönetebilir
      allow read, update, delete: if isAdmin();
    }
  }
}
