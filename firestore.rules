rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Yardımcı fonksiyonlar ────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.uid in [
        'y51M7E6YXZT5I04M9YFqGzSgZ7Y2',
        'hW42qgzVJIXr6sOLO0q1zPOdv6w1',
        'd7sLOX946mRfrmkYMRUOJXNa44l2' // Reze
      ];
    }

    // ─── Rooms ────────────────────────────────────────────
    match /rooms/{roomId} {
      // Herkes oda bilgilerini okuyabilir (lobi katılım için gerekli)
      allow read: if isAuthenticated();

      // Oda oluşturma: giriş yapmış kullanıcı
      allow create: if isAuthenticated();

      // Güncelleme: sadece odadaki oyuncular
      allow update: if isAuthenticated()
        && exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid));

      // Silme: sadece host
      allow delete: if isAuthenticated()
        && resource.data.hostId == request.auth.uid;

      // ─── Players alt koleksiyonu ──────────────────────
      match /players/{playerId} {
        // Okuma: odadaki herkes
        allow read: if isAuthenticated();

        // Oluşturma: sadece kendi belgesini oluşturabilir
        allow create: if isAuthenticated()
          && isOwner(playerId);

        // Güncelleme: kendi verisi VEYA host (skor güncellemesi için)
        allow update: if isAuthenticated()
          && (isOwner(playerId)
            || get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid);

        // Silme (odadan çıkma): kendi belgesi veya host
        allow delete: if isAuthenticated()
          && (isOwner(playerId)
            || get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid);
      }
    }

    // ─── Games ────────────────────────────────────────────
    match /games/{gameId} {
      // Okuma: giriş yapmış herkes (visibility filtrelemesi client-side)
      allow read: if isAuthenticated();

      // Oluşturma: giriş yapmış kullanıcı
      allow create: if isAuthenticated();

      // Güncelleme: giriş yapmış kullanıcı (oyun akışı için gerekli)
      // NOT: İdeal olarak Cloud Functions ile sunucu taraflı yapılmalı
      allow update: if isAuthenticated();

      // Silme: yok (oyunlar silinmez, Cloud Function temizler)
      allow delete: if false;

      // ─── Votes alt koleksiyonu ──────────────────────
      match /votes/{voterId} {
        // Okuma: tüm oyuncular (oy sayma için)
        allow read: if isAuthenticated();

        // Yazma: sadece kendi oyunu yazabilir
        allow create: if isAuthenticated()
          && isOwner(voterId);
        allow update: if isAuthenticated()
          && isOwner(voterId);

        // Silme: oyun mantığı tarafından (host veya kendi)
        allow delete: if isAuthenticated();
      }
    }

    // ─── Users (Profil + Cüzdan + Envanter) ──────────────
    match /users/{userId} {
      // Okuma: herkes (avatar vb. görmek için)
      allow read: if isAuthenticated();

      // Oluşturma: kendi belgesini
      allow create: if isAuthenticated()
        && isOwner(userId);

      // Güncelleme: kendi belgesini
      // NOT: walletPoints güvenliği Cloud Function (onGameFinished) ile sağlanır.
      // Client-side güncellemeler: sadece profil, avatar, cosmetics vs.
      allow update: if isAuthenticated()
        && isOwner(userId);

      // Silme yok
      allow delete: if false;

      // ─── Custom Tasks alt koleksiyonu ─────────────────
      match /custom_tasks/{taskId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }

    // 🛍️ Cosmetics (Mağaza Öğeleri) 🛍️
    match /cosmetics/{cosmeticId} {
      allow read: if isAuthenticated();
      // Yalnızca adminler kozmetikleri seed edebilir/güncelleyebilir
      allow write: if isAdmin();
    }

    // ─── Tasks (Görevler ve Admin) ────────────────────────
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      // Yalnızca adminler görev ekleyebilir, silebilir veya güncelleyebilir.
      allow write: if isAdmin();
    }
    
    match /taskFeedback/{feedbackId} {
      allow read: if isAuthenticated();
      // Herkes feedback verebilir.
      allow create: if isAuthenticated();
      // Feedback güncellenemez/silinemez
      allow update, delete: if false;
    }
    
    // ─── Raporlar (Moderasyon) ────────────────────────────
    match /reports/{reportId} {
      // Herkes rapor oluşturabilir (şikayet mekanizması)
      allow create: if isAuthenticated();
      // Yalnızca adminler raporları okuyabilir ve yönetebilir
      allow read, update, delete: if isAdmin();
    }
  }
}
